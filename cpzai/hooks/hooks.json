{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^mcp__(plugin_cpzai_)?cpzai__(place_order|execute_strategy|create_strategy|update_strategy|configure_overlay|create_webhook|delete_webhook|sync_portfolio|create_connection)$",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/pre_trade_guard.py"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__(plugin_cpzai_)?cpzai__(place_order|execute_strategy|create_strategy|update_strategy|configure_overlay|create_webhook|delete_webhook|sync_portfolio|create_connection)$",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/audit_log.py"
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "matcher": "^mcp__(plugin_cpzai_)?cpzai__(place_order|execute_strategy|create_strategy|update_strategy|configure_overlay|create_webhook|delete_webhook|sync_portfolio|create_connection)$",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PLUGIN_ROOT}/scripts/audit_log.py"
          }
        ]
      }
    ]
  }
}
